FROM alpine

RUN apk add npm nodejs
RUN apk add bash shadow

ENV SCRIPTS_DIR=/tmp/scripts
COPY builder/scripts $SCRIPTS_DIR

ARG OUTPUT_OWNER_UID
RUN $SCRIPTS_DIR/add-docker-user "$OUTPUT_OWNER_UID"

COPY --chown=$OUTPUT_OWNER_UID  kasmweb/ /src/www
COPY --chown=$OUTPUT_OWNER_UID  builder/build-www-inside-docker /src/

WORKDIR /src/www

USER $OUTPUT_OWNER_UID

RUN mv package.json package.upstream.json
COPY --chown=$OUTPUT_OWNER_UID builder/kasmweb-package.json /src/www/package.json
COPY --chown=$OUTPUT_OWNER_UID builder/kasmweb-package-lock.json /src/www/package-lock.json
RUN npm ci --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org/ && \
    mv package.upstream.json package.json

ENTRYPOINT [ "/src/build-www-inside-docker" ]
