#!/usr/bin/env bash

set -ex pipefail

LIBYUV_REPO="https://chromium.googlesource.com/libyuv/libyuv"
LIBYUV_SRC_DIR="/tmp/libyuv"

prepare_source() {
  [ -d "$LIBYUV_SRC_DIR" ] && rm -rf "$LIBYUV_SRC_DIR"

  # Pin the reviewed stable revision; a moving branch can change a rebuild.
  git init "$LIBYUV_SRC_DIR"
  cd "$LIBYUV_SRC_DIR"
  git remote add origin "$LIBYUV_REPO"
  git fetch --depth 1 origin eb6e7bb63738e29efd82ea3cf2a115238a89fa51
  git checkout --detach FETCH_HEAD
}

build_and_install() {
  export MAKEFLAGS=-j$(nproc)

  # Disable problematic NEON64 assembly for ARM64
  if [ "$(uname -m)" = "aarch64" ]; then
    EXTRA_CXXFLAGS="-DLIBYUV_DISABLE_NEON"
  else
    EXTRA_CXXFLAGS=""
  fi

  cp -r include/ "$HOME/.local/"
  make V=1 -f linux.mk CFLAGS="-O2 -fomit-frame-pointer -fPIC -Iinclude/" CXXFLAGS="-O2 -fomit-frame-pointer -fPIC -Iinclude/ $EXTRA_CXXFLAGS"

  install -D -m 0644 libyuv.a "$HOME/.local/lib/libyuv.a"
}

prepare_source
build_and_install
