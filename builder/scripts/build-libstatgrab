#!/usr/bin/env bash

set -euo pipefail
source "$(dirname "$0")/fetch-source.sh"

build_and_install() {
    ./autogen.sh
    CFLAGS="-fPIC" ./configure --prefix="$HOME/.local" --disable-shared --enable-static --disable-man
    make -j"$(nproc)"
    make install
}

prepare_source() {
    DIR=libstatgrab
    cd /tmp
    [ -d ./${DIR} ] && rm -rf ./${DIR}
    mkdir ${DIR}

    LIBSTATGRAB_RELEASE="${LIBSTATGRAB_RELEASE:-LIBSTATGRAB_0_92_1}"

    fetch_source statgrab "$LIBSTATGRAB_RELEASE" "https://github.com/libstatgrab/libstatgrab/archive/${LIBSTATGRAB_RELEASE}.tar.gz" /tmp/statgrab-source.tar.gz
    tar xzf /tmp/statgrab-source.tar.gz -C "${DIR}/" --strip-components=1
    cd ${DIR}
}

prepare_source
build_and_install
