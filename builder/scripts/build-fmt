#!/usr/bin/env bash

set -euo pipefail
source "$(dirname "$0")/fetch-source.sh"

build_and_install() {
    cmake -S . -B build -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_SHARED_LIBS=OFF -DFMT_TEST=OFF -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=$HOME/.local -GNinja
    ninja -C build install
}

prepare_source() {
    DIR=fmt
    cd /tmp
    [ -d ./${DIR} ] && rm -rf ./${DIR}
    mkdir ${DIR}

    FMT_RELEASE="${FMT_RELEASE:-12.2.0}"

    fetch_source fmt "$FMT_RELEASE" "https://github.com/fmtlib/fmt/archive/${FMT_RELEASE}.tar.gz" /tmp/fmt-source.tar.gz
    tar xzf /tmp/fmt-source.tar.gz -C "${DIR}/" --strip-components=1
    cd ${DIR}
}

prepare_source
build_and_install
